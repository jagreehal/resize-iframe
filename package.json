{
  "name": "resize-iframe",
  "version": "0.3.0",
  "description": "Iframes that size themselves to their content, cross-origin included. No build step, no dependencies.",
  "type": "module",
  "main": "resize-iframe.js",
  "module": "resize-iframe.js",
  "types": "resize-iframe.d.ts",
  "exports": {
    ".": {
      "types": "./resize-iframe.d.ts",
      "import": "./resize-iframe.js",
      "default": "./resize-iframe.js"
    },
    "./element": {
      "types": "./element.d.ts",
      "import": "./element.js",
      "default": "./element.js"
    },
    "./inject": {
      "types": "./inject.d.ts",
      "import": "./inject.js",
      "default": "./inject.js"
    },
    "./resize-iframe-child.js": "./resize-iframe-child.js"
  },
  "files": [
    "resize-iframe.js",
    "resize-iframe-child.js",
    "resize-iframe.d.ts",
    "element.js",
    "element.d.ts",
    "inject.js",
    "inject.d.ts",
    "child-source.js",
    "CHANGELOG.md"
  ],
  "packageManager": "pnpm@11.21.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "embed-child": "node scripts/embed-child.mjs",
    "pretest": "pnpm embed-child",
    "prepublishOnly": "pnpm embed-child",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit --strict --lib es2022,dom resize-iframe.d.ts element.d.ts inject.d.ts",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "keywords": [
    "iframe",
    "iframe-resizer",
    "resize",
    "web-components",
    "custom-element",
    "postmessage",
    "storage-access",
    "third-party-cookies"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jagreehal/resize-iframe.git"
  },
  "homepage": "https://github.com/jagreehal/resize-iframe#readme",
  "bugs": "https://github.com/jagreehal/resize-iframe/issues",
  "author": "Jag Reehal <jag@jagreehal.com>",
  "license": "MIT",
  "devDependencies": {
    "@changesets/cli": "2.31.0",
    "@playwright/test": "1.60.0",
    "serve": "14.2.6",
    "typescript": "6.0.3"
  }
}
